//////////////////////////////
// Switches
//////////////////////////////
world/switch01/on 						"sounds/world/switch01_on.ogg"
world/switch01/off 						"sounds/world/switch01_off.ogg"

//////////////////////////////
// Neoscape
//////////////////////////////
ambience/neoscape 						"sounds/world/sfx_ambient_neoscape_loop.ogg"
$ambient 54 ambience/neoscape point continuous 1.0

//////////////////////////////
// Waterfall
//////////////////////////////
ambience/waterfall/normal 				"sounds/world/sfx_ambient_waterfall_normal_loop.ogg"
$ambient 55 ambience/waterfall/normal point continuous 1.0
ambience/waterfall/cave 				"sounds/world/sfx_ambient_waterfall_cave_loop.ogg"
$ambient 56 ambience/waterfall/cave point continuous 1.0
ambience/waterfall/exit 				"sounds/world/sfx_ambient_waterfall_exit.ogg"

//////////////////////////////
// Fridge
//////////////////////////////
world/fridge/open 						"sounds/world/sfx_fridge_open.ogg"
world/fridge/close 						"sounds/world/sfx_fridge_close.ogg"
ambience/fridge/loop 					"sounds/world/sfx_fridge_loop.ogg"
$volume ambience/fridge/loop 0.3
$rolloff ambience/fridge/loop 100 212

//////////////////////////////
// Misc
//////////////////////////////
world/jumppad "sounds/world/sfx_jumppad.ogg"
$volume world/jumppad 0.8