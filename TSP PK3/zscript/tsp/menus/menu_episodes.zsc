Class TSP_EpisodeMenu : ListMenu
{
	mixin TSP_MenuMixin;
	
	int id_gamemode;
	
	int id_bh;

	override void Init(Menu parent, ListMenuDescriptor desc)
	{
		Super.Init(parent, desc);
		for ( int i = 0; i < mDesc.mItems.Size(); i++ )
		{
			let item = ListMenuItemTextItem(mDesc.mItems[i]);
			
			if ( !item ) continue;
			
			if ( item.mText == "TSPSpecialMapWarp" )
			{
				id_bh = i;
			}
		}
		//Console.Printf("Squiritng shart");
	}
	
	void GamemodeHack(int num)
	{
		id_gamemode = num;
		if ( id_gamemode == 1 )
		{
			BountyHuntersInit();
		}
		else
		{
			for ( int i = 0; i < mDesc.mItems.Size(); i++ )
			{
				let item = ListMenuItemTextItem(mDesc.mItems[i]);
				
				if ( !item ) continue;
				if ( item.mText == "TSPSpecialMapWarp" )
				{
					continue;
				}
				
				let button = new("TSP_MenuButton");
				button.Init();
				button.text = item.mText;
				button.pos = (480, 32+i*24);
				button.size = (128, 24);
				
				let menuaction = new("TSP_MenuAction");
				menuaction.type = TSP_MenuAction.RETURN_VALUE;
				menuaction.value = ""..i;
				button.menuaction = menuaction;
				
				AddItem(button);
			}
		}
		
		mDesc.mItems.Clear();
	}
	
	override void Ticker ()
	{
		//SetMenu("SkillMenu", 0);
		//Super.Ticker();
	}
	
	override void Drawer ()
	{
		DrawItems();
	}
	
	override bool MouseEvent(int type, int x, int y)
	{
		string ret = UpdateMouse(type, x, y);
		
		if ( ret != "" )
		{
			if ( id_gamemode == 1 )
			{
				Console.Printf("Forcing "..id_bh);
				let cvar = CVar.GetCVar("_tsp_bhmap");
				cvar.SetString(ret);
				SetMenu("SkillMenu", id_bh);
			}
			else
			{
				SetMenu("SkillMenu", ret.ToInt());
			}
		}
		
		return Super.MouseEvent(type, x, y);
	}
	
	override bool OnUIEvent(UIEvent ev)
	{ 
		bool res = false;
		int y = ev.MouseY;
		if (ev.type == UIEvent.Type_LButtonDown)
		{
			res |= MouseEvent(MOUSE_Click, ev.MouseX, y);
			if (res)
			{
				SetCapture(true);
			}

		}
		else if (ev.type == UIEvent.Type_MouseMove)
		{
			if (mMouseCapture || m_use_mouse == 1)
			{	
				res |= MouseEvent(MOUSE_Move, ev.MouseX, y);
			}
		}
		else if (ev.type == UIEvent.Type_LButtonUp)
		{
			if (mMouseCapture)
			{
				SetCapture(false);
				res |= MouseEvent(MOUSE_Release, ev.MouseX, y);
			}
		}
		return false; 
	}
}

