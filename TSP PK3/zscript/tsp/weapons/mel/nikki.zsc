/*
	The Space Pirate
	Darling Nikki
	
	Gunody pistwell.
*/

Class TSP_Weapon_DarlingNikki : TSP_BaseWeapon
{
	States
	{
		Select:
			W010 A 1 A_Raise();
			Wait;
		Deselect:
			W010 A 1 A_TSP_Deselect();
			Wait;
		Ready:
			W010 A 1 A_WeaponReady();
			Loop;
		Fire:
			W010 B 2 A_TSP_FireBullets(15, 15, 2, 10);
			W010 C 2;
			W010 A 2;
			Goto Ready;
	}
}