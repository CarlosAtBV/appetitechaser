/*
	The Space Pirate
	Fists
	
	Punchody fistswell.
*/

Class TSP_Weapon_MelFists : TSP_BaseWeapon
{
	States
	{
		Select:
			W000 A 1 A_Raise();
			Wait;
		Deselect:
			W000 A 1 A_TSP_Deselect();
			Wait;
		Ready:
			W000 A 1 A_WeaponReady();
			Loop;
		Fire:
			W000 E 1 A_WeaponOffset(32,32+32);
			W000 F 1 A_WeaponOffset(16,32+16);
			W000 A 0 A_TSP_Melee(10);
			W000 G 1 A_WeaponOffset(-2,32-2);
			W000 G 1 A_WeaponOffset(1,32+1);
			W000 G 5 A_WeaponOffset(0,32);
			W000 G 1 A_WeaponOffset(1,32+1);
			W000 G 1 A_WeaponOffset(2,32+2);
			W000 G 1 A_WeaponOffset(4,32+4);
			W000 G 1 A_WeaponOffset(16,32+16);
			W000 G 1 A_WeaponOffset(32,32+32);
			Goto Ready;
	}
}