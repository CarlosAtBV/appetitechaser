/*
	The Space Pirate
	Shiva Gauntlets
	
	Robotody Hitswell
*/

Class TSP_Weapon_ShivaGauntlets : TSP_BaseWeapon
{
	States
	{
		Select:
			151G A 1 A_Raise();
			Wait;
		Deselect:
			151G A 1 A_TSP_Deselect();
			Wait;
		Ready:
			151G A 1 A_WeaponReady();
			Loop;
		Fire:
			151G B 1 A_TSP_Melee(40);
			151G A 1;
			Goto Ready;
	}
}