/*
	The Space Pirate
	Shiva Gauntlets
	
	Robotody Hitswell
*/

Class TSP_Weapon_ShivaGauntlets : TSP_BaseWeapon
{
	States
	{
		Select:
			W010 A 1 A_Raise();
			Wait;
		Deselect:
			W010 A 1 A_TSP_Deselect();
			Wait;
		Ready:
			W010 A 1 A_WeaponReady();
			Loop;
		Fire:
			W010 C 1;
			Goto Ready;
	}
}