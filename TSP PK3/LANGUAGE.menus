TSPMAP_DEMOHUB_NAME2 = "\c[TSP_Yellow]Welcome to \c[TSPMenuGreen]Demoscape\c[TSP_Yellow]!";
TSPMAP_DEMOHUB_DESC2 = "\ccEnjoy your stay!";
TSPMAP_DEMOHUB_DESC3 = "\c[TSP_Green]TIP\cc: Be on the lookout for \c[Gold]secrets\cc!";


