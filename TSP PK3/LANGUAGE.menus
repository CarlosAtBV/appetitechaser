// DIFFICULTY MENUS
TSPDIF_CASUAL = "\c[TSP_LightBlue]Easy Peasy";
TSPDIF_CASUAL_SUB = "(\c[TSP_LightBlue]CASUAL\c-) Stress-free piracy!\nMinimal enemy enforcements, enemies deal \c[TSP_LightBlue]less\c- damage.";
TSPDIF_NORMAL = "\c[TSP_LightGreen]Bring it On!";
TSPDIF_NORMAL_SUB = "(\c[TSP_LightGreen]NORMAL\c-) A moderate challenge.\nStandard difficulty for most privateers.";
TSPDIF_HARD = "\c[TSP_Orange]High Intensity!!";
TSPDIF_HARD_SUB = "(\c[TSP_Orange]HARD\c-) Tough opposition lies ahead!\nLarger enemy presence, more \c[TSP_Orange]danger\c-! For veteran pirates!";
TSPDIF_EXTREME = "\c[TSP_Red]Blood and Bone!!!";
TSPDIF_EXTREME_SUB = "(\c[TSP_Red]EXTREME\c-) Unrelenting pressure!\nHighly \c[TSP_Red]aggressive\c- opponents. For master raiders!";
TSPDIF_ULTIMATE = "\c[TSP_UltimatePurple]Riches or Ruin!!!!";
TSPDIF_ULTIMATE_SUB = "(\c[TSP_UltimatePurple]ULTIMATE\c-) Fight against all odds!\nIncredibly bloodthirsty enemies deal \c[TSP_UltimatePurple]double\c- damage! For super pirates!";

TSPDIF_UNLIMITED = "\c[TSP_Gold]Unlimited Battle";
TSPDIF_UNLIMITED_SUB = "(\c[TSP_Gold]SPECIALTY\c-) \c[TSP_Gold]An unending battle!\c- The enemies \c[TSP_Gold]don't stop\c- until you \c[TSP_Gold]drop\c-! \c[TSP_Gold]No time limit\c-!";
TSPDIF_HEAVENORHELL = "\c[TSP_DantePurple]Death to Pirates!!!!!";
TSPDIF_HEAVENORHELL_SUB = "(\c[TSP_DantePurple]SPECIALTY\c-) One shot, one kill!\nEverything dies in \c[TSP_DantePurple]one hit\c-, including \c[TSP_DantePurple]YOU\c-!";


